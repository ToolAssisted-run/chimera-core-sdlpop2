Subject: a frontend can count the time before the game clock starts

Two weak hooks, each a no-op in SDLPoP2's own build: clock_stopped_tick()
is called on every tick of play the clock would have counted had it been
running - it stays stopped until the first story scene after level 4 -
and never in a demo; clock_set_for_game() is called where a new game sets
the clock, so a count kept outside starts over with it. Together they let
a frontend report the in-game time from the start of level 1.

diff --git a/source/game.c b/source/game.c
index 41c16e4..3077da7 100644
--- a/source/game.c
+++ b/source/game.c
@@ -8,9 +8,13 @@ uint16_t minutes_left = 75, clock_ticks = 0x2CF;   /* DS:5CD2 (0x4B at the start
 uint16_t word_5cb6, word_5cc0; int8_t byte_016a;   /* DS:5CB6 / 5CC0; DS:016A (negative: clock stopped) */
 uint16_t frame_delay;                               /* DS:24DE */
 
+/* a frontend may count the ticks the clock would have run had it started with the game - it stays stopped until the
+ * first story scene after level 4 (DS:016A) - in play and not in a demo (none: nothing counts them) */
+__attribute__((weak)) void clock_stopped_tick(void) {}
 /* 0823:0D5A: the clock runs while the prince lives; messages at every 5th minute, the last five and the last seconds */
 void game_clock(void)
 {
+	if (byte_016a < 0 && Kid.alive < 0 && minutes_left != 0 && !word_2ba8) clock_stopped_tick();
 	if (byte_016a >= 0 && Kid.alive < 0 && minutes_left != 0) {
 		if (--clock_ticks == 0) {
 			clock_ticks = (uint16_t)GAME_SETTING(ticks_per_minute, 0x2CF);   /* 0823:0D5A (SDLPoP2.ini ticks_per_minute) */
diff --git a/source/level.c b/source/level.c
index 6e5aa58..8fa5982 100644
--- a/source/level.c
+++ b/source/level.c
@@ -257,6 +257,8 @@ int story_scene(int prev, int n)
 }
 int level_switch;          /* platform: with the cheat word, a LEVELn switch on the command line (DS:0978 via 194C:2CEA) */
 uint16_t word_2b96;        /* DS:2B96 */
+/* a frontend may be told a new game set the clock, as its time starts over (none: nothing to tell) */
+__attribute__((weak)) void clock_set_for_game(void) {}
 /* 169B:0006 (before play_level): a new game. 1286:0050 (a drawing buffer) left out; 169B:018E runs four OVL01
  * initialisers that each clear DS:2B96 */
 void game_start(void)
@@ -265,6 +267,7 @@ void game_start(void)
 	word_5cdc = word_5cda = word_5ce8 = word_5cd0 = 0;
 	if (word_5cb6) return;
 	minutes_left = (uint16_t)GAME_SETTING(start_minutes_left, 75); clock_ticks = (uint16_t)GAME_SETTING(ticks_per_minute, 0x2CF); start_hp = (uint8_t)GAME_SETTING(start_hitp, 3);   /* 169B:0006 (SDLPoP2.ini start_minutes_left, ticks_per_minute, start_hitp) */
+	clock_set_for_game();
 	/* 169B:0006 tests DS:10C2 and DS:0978; DS:0978 (level_switch) is only set with the cheat word, which alone decides
 	 * here (SDLPoP2's menu can turn DS:10C2 off or on since the start) */
 	if (level_switch) { int8_t v = (int8_t)level_number; start_hp = v < 3 ? 3 : v > 12 ? 12 : v; }
