      "Cheat Look Up": "8",
      "Cheat Look Down": "2",
      "Cheat Teleport": "T",
      "Cheat Fly": "A"
    }
  },
  "settings": [
    {
      "name": "version",
      "display": "Version",
      "type": "enum",
      "options": [
        "1.1",
        "1.0",
        "ir"
      ],
      "default": "1.1",
      "description": "Which DOS release of the game is played. The project supplies that release's files (see SDLPoP2's docs/VERSIONS.md). '1.1' is the release on the Prince of Persia Collection CD, which SDLPoP2 is rebuilt from. The others are '1.0' and the initial release ('ir'). The releases differ in movement near walls and gates, the guards, the spirit, levels 2, 5, 8 and 14, the timers and random numbers, and a few story scenes. 1.0 and 1.1 have the same data files and differ only in PRINCE.EXE. The initial release has files of its own (twelve of them differ), and its cheat word is makinit."
    },
    {
      "name": "music",
      "display": "Sound Device",
      "type": "enum",
      "options": [
        "roland",
        "fm",
        "speaker"
      ],
      "default": "roland",
      "description": "What plays the sound. 'roland' (the default) plays the music on a Roland MT-32 connected to an MPU-401, which the game's setup program calls \"Roland MT-32/LAPC-1/CM-32L\". 'fm' plays it on the FM chip of the Sound Blaster Pro, which is what the original setup program chose. Both use the Sound Blaster's digitized sounds. 'speaker' uses the PC speaker alone, with the game's own speaker player and speaker sounds (IBMSND.DAT, NISIBM.DAT). The game knows which device it has. With the speaker it answers \"Music Unavailable\", plays no background music, and waits after a death or at the end of a level for as long as the speaker's sounds last, as the original did on such a machine. The timing of the story scenes is still the sound card's. The MT-32 needs the setup program's PRESET40.DEF and the two ROMs of an MT-32 (version 1.07), which the project supplies as firmware. With it the game starts 9.35 seconds later, as the original did, while the instrument sounds are sent to the MT-32. So a movie plays back only with the sound device it was made with."
    },
    {
      "name": "random_seed",
      "display": "Random seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "description": "The starting value (seed) of the game's random number generator. The DOS program took it from the clock. A movie records the number it ran with."
    },
    {
      "name": "player_name",
      "display": "Player Name (Hall of Fame)",
      "type": "string",
      "default": "Chimera",
      "description": "The name that a won game enters in the hall of fame when its time earns a place there. The game types it into its own name editor, as the keys would have typed it. Only the characters in the game's font are used, and only as many as fit in the box (24 at most). The controls have no letter keys, so the game enters the name by itself."
    },
    {
      "name": "cheats",
      "display": "Enable Cheats",
      "type": "bool",
      "default": false,
      "description": "Starts the program with the cheat word on its command line (yippeeyahoo, or makinit for the initial release), as the original allowed. The cheat buttons exist only when this is on. They cover the DOS game's cheats and SDLPoP2's own. Next Level (Alt+N) can then reach any level."
    },
    {
      "name": "igt_from_level_1",
      "display": "IGT From Level 1",
      "type": "bool",
      "default": true,
      "description": "Makes the in-game time (IGT, the project's GameTime) count from the very beginning of level 1. The game's own clock stays stopped until the first story scene after level 4, so without this setting the levels before it add nothing. With it, their ticks of play are added, counted the way the clock counts them (while the prince is alive). It changes nothing in the game."
    },
    {
      "name": "enable_intro",
      "display": "Intro",
      "type": "bool",
      "default": true,
      "description": "Shows the intro, which is story scenes 7, 4 and 8 of the title sequence. Without it the title goes on to the credits and the demos, where a key starts the game."
    },
    {
      "name": "enable_story_scenes",
      "display": "Story scenes",
      "type": "bool",
      "default": true,
      "description": "Shows the story scenes between the levels, the scene when the time runs out and the ending. A skipped scene counts as played to its end, so the game after it is the same."
    },
    {
      "name": "skip_title",
      "display": "Skip the title",
      "type": "bool",
      "default": false,
      "description": "Skips the title sequence. A new game starts immediately, at the level chosen in First level."
    },
    {
      "name": "start_minutes_left",
      "display": "Starting minutes",
      "type": "int",
      "default": 75,
      "min": 1,
      "max": 32767,
      "description": "The minutes left when a game starts. The original has 75."
    },
    {
      "name": "ticks_per_minute",
      "display": "Clock ticks a minute",
      "type": "int",
      "default": 719,
      "min": 1,
      "max": 65535,
      "description": "How many ticks of the game clock make one minute of the time left. The original has 719. A tick is 1/12 of a second, so a minute of the clock lasts 59.92 seconds."
    },
    {
      "name": "start_hitp",
      "display": "Starting hit points",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 127,
      "description": "The prince's hit points when a game starts. The original has 3."
    },
    {
      "name": "max_hitp_allowed",
      "display": "Most hit points",
      "type": "int",
      "default": 12,
      "min": 1,
      "max": 127,
      "description": "The most hit points the prince can have. Potions of life add nothing above this. The original has 12."
    },
    {
      "name": "skip_level_reduced_minutes",
      "display": "Minutes after Alt+N",
      "type": "int",
      "default": 15,
      "min": 1,
      "max": 32767,
      "description": "The minutes left after skipping a level with Alt+N when the cheats are off (allowed up to level 3). The original has 15."
    },
    {
      "name": "first_level",
      "display": "First level",
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 14,
      "description": "The level a new game starts at. The original starts at 1."
    },
    {
      "name": "base_speed",
      "display": "Walking speed",
      "type": "int",
      "default": 5,
      "min": 1,
      "max": 255,
      "description": "The time between two ticks of play when not fighting, in 1/60 of a second. Smaller is faster. The original has 5."
    },
    {
      "name": "fight_speed",
      "display": "Fighting speed",
      "type": "int",
      "default": 6,
      "min": 1,
      "max": 255,
      "description": "The time between two ticks of play with the sword drawn, in 1/60 of a second. Smaller is faster. The original has 6."
    }
  ],
