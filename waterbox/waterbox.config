    {
      "id": "PRESET40.DEF",
      "display": "Prince of Persia 2 PRESET40.DEF",
      "description": "PRESET40.DEF of Prince of Persia 2 (DOS): the instrument sounds (timbres) for the Roland MT-32. It is a piece of MIDI data that the game sends to the MT-32 when it starts, and the game waits until that is done. The DOS setup program copies it to PRESETS.DEF for that device, and on the CD and the install disks it is SNDDRVRS\\PRESET40.DEF. You have to supply it when the music is played by the Roland MT-32. The package contains none of the game's data. A modified file of your own can be used instead, and the project records exactly which file it was.",
      "size": 20715,
      "sha1": "951F5F9A340F41C128C232AD0CB31329A1722345",
      "name": "PRESET40.DEF",
      "requiredWhen": {
        "setting": "music",
        "in": [
          "roland"
        ]
      }
    },
    {
      "id": "MT32_CONTROL.ROM",
      "display": "Roland MT-32 control ROM",
      "description": "MT32_CONTROL.ROM is not one of the game's files. It is the control ROM of the Roland MT-32, version 1.07, copied from a first-generation unit. You have to supply it when the music is played by the Roland MT-32. The package contains no ROM. Another MT-32 ROM that Munt (the MT-32 emulator used here) knows can be used instead, and the project records exactly which file it was.",
      "size": 65536,
      "sha1": "B083518FFFB7F66B03C23B7EB4F868E62DC5A987",
      "name": "MT32_CONTROL.ROM",
      "requiredWhen": {
        "setting": "music",
        "in": [
          "roland"
        ]
      }
    },
    {
      "id": "MT32_PCM.ROM",
      "display": "Roland MT-32 PCM ROM",
      "description": "MT32_PCM.ROM is not one of the game's files. It is the PCM ROM of the Roland MT-32, which is the same in every MT-32. You have to supply it when the music is played by the Roland MT-32. The package contains no ROM. Another MT-32 ROM that Munt (the MT-32 emulator used here) knows can be used instead, and the project records exactly which file it was.",
      "size": 524288,
      "sha1": "F6B1EEBC4B2D200EC6D3D21D51325D5B48C60252",
      "name": "MT32_PCM.ROM",
      "requiredWhen": {
        "setting": "music",
        "in": [
          "roland"
        ]
      }
    }
  ]
