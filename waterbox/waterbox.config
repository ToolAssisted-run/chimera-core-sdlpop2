{
  "coreName": "SDLPoP2",
  "kind": "game",
  "systemId": "PrinceOfPersia2",
  "author": "Sergio Martin and the SDLPoP2 contributors, from Jordan Mechner's Prince of Persia 2; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-sdlpop2",
  "deterministic": true,
  "memoryLayoutMiB": [
    64,
    8,
    8,
    8,
    64
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The game loads its sound files whole; the program shell's and the story scenes' stacks are mmap'd (MAP_STACK).",
  "video": {
    "_comment": "The DOS game's 320x200 VGA screen (mode 13h), shown on a 4:3 monitor.",
    "width": 320,
    "height": 200,
    "virtualWidth": 320,
    "virtualHeight": 240,
    "vsyncNumerator": 3146875,
    "vsyncDenominator": 269400,
    "_vsync_note": "A frame is one step of the game (docs/game-cores.md): while playing, the VGA frames (70.086 Hz) up to the next game tick, where the controls are read - 5 to 7 of them, 1/12 s walking; on the title, in the story scenes, the menus and the pause, one VGA frame, since the program reads its keys every frame there. GetVsyncNumerator/Denominator report the step just run; 3146875/269400 is six frames.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "SDLPoP2's sound (the Sound Blaster Pro's digitized sounds and its FM music, as the original setup plays them, or the music on a Roland MT-32), rendered at 44100 Hz for exactly the time each step covers: the card's mono on both sides, the MT-32's in stereo.",
    "rate": 44100,
    "samplesPerFrame": 44200,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "Prince of Persia 2",
    "_comment": "The DOS game's keyboard, a button for each key the game reads in play. P1: the arrows, Shift (grab, careful step, pick up, drink; it also chooses the copy protection's symbol, as Enter does) and Ctrl (the sword; the spirit's spell). The game's commands: Pause (Esc) and Show Time (Space) - either also skips a story scene - Restart Level (Alt+A), Restart Game (Alt+R), Next Level (Alt+N), Sound On/Off (Alt+S), Music On/Off (Alt+M), Version (Alt+V), Joystick Mode (Alt+J), Keyboard Mode (Alt+K). With the cheats setting on, the cheats: the DOS game's (Lose Hit Point Shift+K, Opponent Hit Point g, Kill Room k, Spirit Leaves Shift+S, More Time and Less Time keypad + and -, Flip Screen Shift+I, Show Room Shift+R, Add Max Hit Point Shift+T, Feather Fall Shift+W, Revive r, Demo Player F3) and SDLPoP2's own (God Mode Shift+G, Leave Body h, Leave Body Flame b, Sword z, Look Left/Right/Up/Down Alt+arrows, Teleport t, Fly A held). Left out: the game's saved games and its menus (Alt+G, Alt+L, Alt+O, Alt+H, Enter, Tab) and the letter keys; the hall of fame's name is the player_name setting, entered by the game itself. A key pressed is typed once; there is no key repeat.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Shift",
      "P1 Ctrl",
      "Pause",
      "Show Time",
      "Restart Level",
      "Restart Game",
      "Next Level",
      "Sound On/Off",
      "Music On/Off",
      "Version",
      "Joystick Mode",
      "Keyboard Mode",
      "Cheat Lose Hit Point",
      "Cheat Opponent Hit Point",
      "Cheat Kill Room",
      "Cheat Spirit Leaves",
      "Cheat More Time",
      "Cheat Less Time",
      "Cheat Flip Screen",
      "Cheat Show Room",
      "Cheat Add Max Hit Point",
      "Cheat Feather Fall",
      "Cheat Revive",
      "Cheat Demo Player",
      "Cheat God Mode",
      "Cheat Leave Body",
      "Cheat Leave Body Flame",
      "Cheat Sword",
      "Cheat Look Left",
      "Cheat Look Right",
      "Cheat Look Up",
      "Cheat Look Down",
      "Cheat Teleport",
      "Cheat Fly"
    ]
  },
  "settings": [
    {
      "name": "music",
      "display": "Music Device",
      "type": "enum",
      "options": [
        "roland",
        "fm"
      ],
      "default": "roland",
      "description": "What plays the music: a Roland MT-32 on an MPU-401 (roland, the default), the setup's \"Roland MT-32/LAPC-1/CM-32L\", or the Sound Blaster Pro's FM chip (fm), as the original setup chose. The digitized sounds are the Sound Blaster's either way. The MT-32 needs the setup's PRESET40.DEF and an MT-32's two ROMs (v1.07), which the project brings as firmware; its game starts 9.35 s later, as the original did, while the start-up sends the MT-32 its timbres - so a movie plays on the music device it was made with."
    },
    {
      "name": "random_seed",
      "display": "Random seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "description": "The seed of the game's random number generator at start (the DOS program took it from the clock). A movie records the number it ran with."
    },
    {
      "name": "player_name",
      "display": "Player Name (Hall of Fame)",
      "type": "string",
      "default": "Chimera",
      "description": "The name a won game enters in the hall of fame, when its time earns a place there - typed into the game's own editor as the keys would have typed it (the characters the font has, as many as the box holds, up to 24). There are no letter keys: the game enters it by itself."
    },
    {
      "name": "cheats",
      "display": "Enable Cheats",
      "type": "bool",
      "default": false,
      "description": "Start the program with the cheat word on its command line (yippeeyahoo), as the original allowed: the cheats' buttons exist only with this on (the DOS game's cheats and SDLPoP2's own), and Next Level (Alt+N) reaches any level."
    },
    {
      "name": "igt_from_level_1",
      "display": "IGT From Level 1",
      "type": "bool",
      "default": true,
      "description": "The in-game time (IGT, the project's GameTime) counts from the very beginning of level 1. The game's own clock stays stopped until the first story scene after level 4, so without this the levels before it count nothing; with it their ticks of play are added, counted as the clock counts them (while the prince lives). Changes nothing in the game."
    },
    {
      "name": "enable_intro",
      "display": "Intro",
      "type": "bool",
      "default": true,
      "description": "The intro: the story scenes 7, 4 and 8 of the title sequence. Without it the title goes on to the credits and the demos, where a key starts the game."
    },
    {
      "name": "enable_story_scenes",
      "display": "Story scenes",
      "type": "bool",
      "default": true,
      "description": "The story scenes between the levels, the time-out and the ending. A scene skipped counts as played to its end: the game after it is the same."
    },
    {
      "name": "skip_title",
      "display": "Skip the title",
      "type": "bool",
      "default": false,
      "description": "Skip the title sequence: a new game starts at once, at the first level below."
    },
    {
      "name": "start_minutes_left",
      "display": "Starting minutes",
      "type": "int",
      "default": 75,
      "min": 1,
      "max": 32767,
      "description": "The minutes left when a game starts. 75 in the original."
    },
    {
      "name": "ticks_per_minute",
      "display": "Clock ticks a minute",
      "type": "int",
      "default": 719,
      "min": 1,
      "max": 65535,
      "description": "Game clock ticks a minute of the time left. 719 in the original (a tick is 1/12 s, so a minute of the clock is 59.92 s)."
    },
    {
      "name": "start_hitp",
      "display": "Starting hit points",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 127,
      "description": "The prince's hit points when a game starts. 3 in the original."
    },
    {
      "name": "max_hitp_allowed",
      "display": "Most hit points",
      "type": "int",
      "default": 12,
      "min": 1,
      "max": 127,
      "description": "The most hit points the prince can have; the potions of life stop there. 12 in the original."
    },
    {
      "name": "skip_level_reduced_minutes",
      "display": "Minutes after Alt+N",
      "type": "int",
      "default": 15,
      "min": 1,
      "max": 32767,
      "description": "The minutes left after skipping a level with Alt+N without the cheats (allowed up to level 3). 15 in the original."
    },
    {
      "name": "first_level",
      "display": "First level",
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 14,
      "description": "The level a new game starts at. 1 in the original."
    },
    {
      "name": "base_speed",
      "display": "Walking speed",
      "type": "int",
      "default": 5,
      "min": 1,
      "max": 255,
      "description": "The time between two ticks of play when not fighting, in 1/60 s. Smaller is faster. 5 in the original."
    },
    {
      "name": "fight_speed",
      "display": "Fighting speed",
      "type": "int",
      "default": 6,
      "min": 1,
      "max": 255,
      "description": "The time between two ticks of play with the sword drawn, in 1/60 s. Smaller is faster. 6 in the original."
    }
  ],
